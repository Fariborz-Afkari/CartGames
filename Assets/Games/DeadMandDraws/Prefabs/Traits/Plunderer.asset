  TraitId: 13
  Image: {fileID: -5670253393490519623, guid: 42a1a9690e399c345912e05347481955, type: 3}
  TraitType: 12
  Description: "\u0647\u0646\u06AF\u0627\u0645\u06CC \u06A9\u0647 \u0628\u0627\u0632\u06CC\u06A9\u0646\u06CC \u06CC\u06A9 \u06A9\u0644\u06CC\u062F \u0648 \u0635\u0646\u062F\u0648\u0642 \u0631\u0627 \u0645\u0646\u0637\u0642\u0647 \u0628\u0627\u0632\u06CC (BoardPanel) \u062F\u0627\u0631\u062F \u0648 \u0645\u06CC \u062E\u0648\u0627\u0647\u062F \u0646\u0648\u0628\u062A \u062E\u0648\u062F \u0631\u0627 \u067E\u0627\u06CC\u0627\u0646 \u062F\u0627\u062F\u0647 \u0648 \u06A9\u0627\u0631\u062A \u0647\u0627 \u0631\u0627 \u0628\u0647 \u0628\u0627\u0646\u06A9 \u062E\u0648\u062F \u0627\u0636\u0627\u0641\u0647 \u06A9\u0646\u062F\u060C \u0628\u0627\u06CC\u062F \u06A9\u0627\u0631\u062A\u200C\u0647\u0627 \u0631\u0627 \u0627\u0632 \u0628\u0627\u0646\u06A9 \u0628\u0627\u0632\u06CC\u06A9\u0646 \u062F\u06CC\u06AF\u0631\u06CC \u0628\u0631\u062F\u0627\u0631\u062F\u060C \u0646\u0647 \u0627\u0632 \u0627\u0632 \u062F\u06A9 \u0633\u0648\u062E\u062A\u0647  (BurnDeck).\u0627\u06CC\u0646 \u0628\u0627\u0632\u06CC\u06A9\u0646 \u062A\u0646\u0647\u0627 \u0645\u062C\u0627\u0632 \u0627\u0633\u062A \u06A9\u0627\u0631\u062A\u200C\u0647\u0627 \u0631\u0627 \u0627\u0632 \u06CC\u06A9 \u0628\u0627\u0632\u06CC\u06A9\u0646 \u062E\u0627\u0635 \u0628\u0631\u062F\u0627\u0631\u062F. \u0627\u06AF\u0631 \u0622\u0646 \u0628\u0627\u0632\u06CC\u06A9\u0646 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u06A9\u0627\u0641\u06CC \u0628\u0631\u0627\u06CC \u062A\u0623\u0645\u06CC\u0646 \u062A\u0645\u0627\u0645 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u062D\u0642 \u0634\u0645\u0627\u0633\u062A \u0646\u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u060C \u0634\u0645\u0627 \u0622\u0646 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u0627\u0636\u0627\u0641\u06CC \u0631\u0627 \u0627\u0632 \u062F\u0633\u062A \u062E\u0648\u0627\u0647\u06CC\u062F \u062F\u0627\u062F."
  Name: "\u063A\u0627\u0631\u062A\u06AF\u0631"
