  TraitType: 3
  Description: "\u062F\u0631 \u0627\u0628\u062A\u062F\u0627\u06CC \u0628\u0627\u0632\u06CC\u060C \u06CC\u06A9\u06CC \u0627\u0632 \u0628\u0627\u0632\u06CC\u06A9\u0646\u0627\u0646 \u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F. \u0627\u06AF\u0631 \u0622\u0646 \u0628\u0627\u0632\u06CC\u06A9\u0646 \u062F\u0631 \u0637\u0648\u0644 \u0628\u0627\u0632\u06CC \xAB\u0628\u0633\u062A\xBB (bust) \u06A9\u0646\u062F (\u06CC\u0639\u0646\u06CC \u0628\u0633\u0648\u0632\u062F)\u060C \u0634\u0645\u0627 \u06A9\u0627\u0631\u062A\u200C\u0647\u0627\u06CC \u0645\u0648\u062C\u0648\u062F \u062F\u0631 \u0645\u0646\u0637\u0642\u0647 \u0628\u0627\u0632\u06CC (BoardPanel) \u0631\u0627 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u06CC\u062F \u0648 \u0628\u0647 \u0641\u0631\u0633\u062A\u0627\u062F\u0646 \u0628\u0647 \u062F\u06A9 \u0633\u0648\u062E\u062A\u0647  (BurnDeck)\u060C \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u0628\u0647 \xAB\u0628\u0627\u0646\u06A9\xBB \u062E\u0648\u062F \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F."
  Name: "\u0635\u0646\u062F\u0648\u0642\u0686\u0647 \u062F\u06CC\u0648\u06CC \u062C\u0648\u0646\u0632"
