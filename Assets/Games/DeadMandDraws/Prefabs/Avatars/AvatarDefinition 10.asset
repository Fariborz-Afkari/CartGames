  AvatarId: 11
  AvatarName: "\u0686\u0646\u06AF \u0634\u06CC"
  Description: "\u0628\u0627\u0646\u0648\u06CC \u062F\u0632\u062F\u0627\u0646 \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0686\u06CC\u0646 \u062F\u0631 \u0627\u0648\u0627\u06CC\u0644 \u0642\u0631\u0646 \u0646\u0648\u0632\u062F\u0647\u0645 \u0628\u0648\u062F \u06A9\u0647 \u0646\u0627\u0648\u06AF\u0627\u0646 \u0639\u0638\u06CC\u0645\u06CC \u0628\u0647 \u0646\u0627\u0645 \xAB\u0646\u0627\u0648\u06AF\u0627\u0646 \u067E\u0631\u0686\u0645 \u0633\u0631\u062E\xBB \u0631\u0627 \u0641\u0631\u0645\u0627\u0646\u062F\u0647\u06CC \u0645\u06CC\u200C\u06A9\u0631\u062F. \u0642\u0648\u0627\u0646\u06CC\u0646 \u0628\u0633\u06CC\u0627\u0631 \u0633\u062E\u062A\u200C\u06AF\u06CC\u0631\u0627\u0646\u0647\u200C\u0627\u06CC \u0628\u0631\u0627\u06CC \u062E\u062F\u0645\u0647\u200C\u0627\u0634 \u062F\u0627\u0634\u062A \u0648 \u0628\u0631 \u0622\u0628\u200C\u0647\u0627\u06CC \u062C\u0646\u0648\u0628 \u0686\u06CC\u0646 \u062A\u0633\u0644\u0637 \u06CC\u0627\u0641\u062A. \u0627\u0648 \u062F\u0631 \u0646\u0647\u0627\u06CC\u062A \u0639\u0641\u0648 \u06AF\u0631\u0641\u062A \u0648 \u062B\u0631\u0648\u062A\u0645\u0646\u062F \u0648 \u0622\u0632\u0627\u062F \u0645\u0631\u062F."
