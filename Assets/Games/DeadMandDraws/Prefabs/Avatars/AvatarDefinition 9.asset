  AvatarName: "\u06A9\u0627\u067E\u06CC\u062A\u0627\u0646 \u0628\u0644\u0627\u062F"
  Description: "\u0634\u062E\u0635\u06CC\u062A \u0631\u0645\u0627\u0646 \xAB\u06A9\u0627\u067E\u06CC\u062A\u0627\u0646 \u0628\u0644\u0627\u062F\xBB \u0646\u0648\u0634\u062A\u0647 \u0631\u0627\u0641\u0627\u0626\u0644 \u0633\u0627\u0628\u0627\u062A\u06CC\u0646\u06CC \u0627\u0633\u062A. \u0627\u0648 \u062F\u0631 \u0627\u0635\u0644 \u067E\u0632\u0634\u06A9\u06CC \u0627\u06CC\u0631\u0644\u0646\u062F\u06CC \u0628\u0647 \u0646\u0627\u0645 \u067E\u06CC\u062A\u0631 \u0628\u0644\u0627\u062F \u0628\u0648\u062F \u06A9\u0647 \u0646\u0627\u0639\u0627\u062F\u0644\u0627\u0646\u0647 \u0628\u0647 \u0628\u0631\u062F\u06AF\u06CC \u0641\u0631\u0633\u062A\u0627\u062F\u0647 \u0634\u062F. \u0633\u067E\u0633 \u0628\u0647 \u062F\u0632\u062F \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0648 \u06A9\u0648\u0631\u0633\u06CC\u0631\u06CC \u0634\u062C\u0627\u0639 \u062A\u0628\u062F\u06CC\u0644 \u0634\u062F \u0648 \u062F\u0631 \u0646\u0647\u0627\u06CC\u062A \u0628\u0647 \u0642\u0647\u0631\u0645\u0627\u0646\u06CC \u0645\u062D\u0628\u0648\u0628 \u0648 \u062D\u062A\u06CC \u0641\u0631\u0645\u0627\u0646\u062F\u0627\u0631 \u0631\u0633\u06CC\u062F."
