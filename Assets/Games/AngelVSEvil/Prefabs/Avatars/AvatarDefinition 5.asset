  AvatarName: "\u062F\u06CC\u0648\u06CC \u062C\u0648\u0646\u0632"
  Description: "\u0686\u0647\u0631\u0647\u200C\u0627\u06CC \u0627\u0641\u0633\u0627\u0646\u0647\u200C\u0627\u06CC \u062F\u0631 \u0641\u0631\u0647\u0646\u06AF \u062F\u0631\u06CC\u0627\u0646\u0648\u0631\u062F\u0627\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0646\u0627\u0645\u0634 \u0628\u0627 \xAB\u0642\u0641\u0633 \u062F\u06CC\u0648\u06CC \u062C\u0648\u0646\u0632\xBB \u0648 \u062F\u0646\u06CC\u0627\u06CC \u0645\u0631\u062F\u06AF\u0627\u0646 \u067E\u06CC\u0648\u0646\u062F \u062E\u0648\u0631\u062F\u0647. \u062F\u0631 \xAB\u062F\u0632\u062F\u0627\u0646 \u062F\u0631\u06CC\u0627\u06CC\u06CC \u06A9\u0627\u0631\u0627\u0626\u06CC\u0628\xBB\u060C \u06A9\u0627\u067E\u06CC\u062A\u0627\u0646 \u06A9\u0634\u062A\u06CC \u0647\u0644\u0646\u062F\u06CC \u067E\u0631\u0646\u062F\u0647 \u0648 \u0647\u06CC\u0648\u0644\u0627\u06CC\u06CC \u0628\u0627 \u0686\u0647\u0631\u0647 \u0627\u062E\u062A\u0627\u067E\u0648\u0633\u06CC \u0627\u0633\u062A. \u0642\u0644\u0628\u0634 \u0631\u0627 \u062F\u0631 \u0635\u0646\u062F\u0648\u0642\u06CC \u067E\u0646\u0647\u0627\u0646 \u06A9\u0631\u062F\u0647 \u0648 \u0627\u0631\u0648\u0627\u062D \u062F\u0631\u06CC\u0627\u0646\u0648\u0631\u062F\u0627\u0646 \u0631\u0627 \u062C\u0645\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F."
