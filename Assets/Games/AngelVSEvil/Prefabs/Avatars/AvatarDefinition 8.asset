  AvatarId: 9
  AvatarName: "\u062A\u06CC\u0627 \u062F\u0627\u0644\u0645\u0627"
  Description: "\u0634\u062E\u0635\u06CC\u062A\u06CC \u0645\u0631\u0645\u0648\u0632 \u0648 \u062C\u0627\u062F\u0648\u06AF\u0631 \u06A9\u0647 \u062F\u0631 \u06A9\u0644\u0628\u0647\u200C\u0627\u06CC \u0628\u0627\u062A\u0644\u0627\u0642\u06CC \u0648 \u062F\u0648\u0631\u0627\u0641\u062A\u0627\u062F\u0647 \u0632\u0646\u062F\u06AF\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0648 \u0628\u0627 \u0637\u0644\u0633\u0645 \u0648 \u067E\u06CC\u0634\u06AF\u0648\u06CC\u06CC \u0633\u0631 \u0648 \u06A9\u0627\u0631 \u062F\u0627\u0631\u062F \u0648 \u062F\u0631 \u0644\u062D\u0638\u0627\u062A \u062D\u0633\u0627\u0633 \u0628\u0647 \u062C\u06A9 \u0627\u0633\u067E\u0627\u0631\u0648\u060C \u0648\u06CC\u0644 \u062A\u0631\u0646\u0631 \u0648 \u0627\u0644\u06CC\u0632\u0627\u0628\u062A \u0633\u0648\u0627\u0646 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0648 \u062F\u0631 \u0648\u0627\u0642\u0639  \u0627\u0644\u0647\u0647 \u062F\u0631\u06CC\u0627 \u0648 \u0645\u0639\u0634\u0648\u0642\u0647 \u062F\u06CC\u0648\u06CC \u062C\u0648\u0646\u0632 \u0627\u0633\u062A \u06A9\u0647 \u062A\u0648\u0633\u0637 \u0627\u0648\u0644\u06CC\u0646 \u0634\u0648\u0631\u0627\u06CC \u062F\u0632\u062F\u0627\u0646 \u062F\u0631\u06CC\u0627\u06CC\u06CC \u062F\u0631 \u0628\u062F\u0646 \u0627\u0646\u0633\u0627\u0646\u06CC \u0632\u0646\u062F\u0627\u0646\u06CC \u0634\u062F\u0647 \u0628\u0648\u062F. \u0628\u0627\u0631\u0628\u0648\u0633\u0627 \u0627\u0648 \u0631\u0627 \u0622\u0632\u0627\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062A\u06CC\u0627 \u062F\u0627\u0644\u0645\u0627 \u0628\u0647 \u0634\u06A9\u0644 \u0637\u0648\u0641\u0627\u0646 \u0648 \u06AF\u0631\u062F\u0627\u0628\u06CC \u0639\u0638\u06CC\u0645 \u0638\u0627\u0647\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u0627\u0646\u062A\u0642\u0627\u0645\u0634 \u0631\u0627 \u0627\u0632 \u062F\u0632\u062F\u0627\u0646 \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0628\u06AF\u06CC\u0631\u062F."
