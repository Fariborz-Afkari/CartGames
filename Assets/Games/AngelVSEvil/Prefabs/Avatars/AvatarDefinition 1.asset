  AvatarName: "\u0627\u0644\u06CC\u0632\u0627\u0628\u062A"
  Description: "\u0627\u0648 \u062F\u0631 \u0627\u0628\u062A\u062F\u0627 \u062F\u062E\u062A\u0631 \u0641\u0631\u0645\u0627\u0646\u062F\u0627\u0631 \u0633\u0644\u0637\u0646\u062A\u06CC \u067E\u0648\u0631\u062A \u0631\u0648\u06CC\u0627\u0644 \u0627\u0633\u062A\u061B \u0645\u062E\u0641\u06CC\u0627\u0646\u0647 \u0634\u06CC\u0641\u062A\u0647 \u062F\u0646\u06CC\u0627\u06CC \u062E\u0637\u0631\u0646\u0627\u06A9 \u062F\u0632\u062F\u0627\u0646 \u062F\u0631\u06CC\u0627\u06CC\u06CC \u0634\u062F\u0647 \u0627\u0633\u062A. \u0627\u0644\u06CC\u0632\u0627\u0628\u062A \u0628\u0647\u200C\u062A\u062F\u0631\u06CC\u062C \u0627\u0632 \u06CC\u06A9 \xAB\u0628\u0627\u0646\u0648\u06CC \u062F\u0631\u0628\u0646\u062F\xBB \u06A9\u0647 \u0645\u0646\u062A\u0638\u0631 \u0646\u062C\u0627\u062A \u0627\u0633\u062A\u060C \u0628\u0647 \u062C\u0646\u06AF\u062C\u0648\u06CC\u06CC \u0645\u0628\u0627\u0631\u0632 \u0648 \u0645\u0633\u062A\u0642\u0644 \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u062E\u0648\u062F \u0634\u0645\u0634\u06CC\u0631 \u0645\u06CC\u200C\u0632\u0646\u062F \u0648 \u062F\u0631 \u0646\u0628\u0631\u062F\u0647\u0627 \u0645\u06CC\u200C\u062C\u0646\u06AF\u062F. "
